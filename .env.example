# Mivida Clinic Website Environment Variables
# Copy this file to .env.local and fill in your values

# Site URL (for SEO and sitemap)
NEXT_PUBLIC_SITE_URL=https://mivida-clinic.com

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Contact form (if using backend)
# CONTACT_FORM_ENDPOINT=https://api.example.com/contact

# Revalidation secret (for ISR)
# REVALIDATION_SECRET=your-secret-key